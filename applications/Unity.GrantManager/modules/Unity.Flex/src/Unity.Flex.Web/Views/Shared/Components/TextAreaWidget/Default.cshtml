@using Unity.Flex.Web.Views.Shared.Components;
@using Unity.Flex.Web.Views.Shared.Components.TextAreaWidget;
@using Unity.Flex.Worksheets.Definitions;
@using Unity.Flex;

@model TextAreaViewModel;

@if (Model.Field != null)
{
    
    var fieldId = Model.WorksheetId.HasValue
        ? $"{Model.Field.Name}.{Model.Name}.{Model.Field.Id}.{Model.WorksheetId}"
        : $"{Model.Field.Name}.{Model.Name}.{Model.Field.Id}";
    
    var fieldDef = (TextAreaDefinition?)Model.Field?.Definition?.ConvertDefinition(Model.Field.Type);

    <textarea id="@fieldId"
              name="@fieldId"
              rows="@(fieldDef?.Rows ?? 1)"
              maxlength="@(fieldDef?.MaxLength)"
              placeholder="@fieldDef?.Placeholder"
              class="form-control"              
              data-worksheet-name="@Model.Name"
              data-ui-anchor="@Model.Field?.UiAnchor"
              onchange="notifyFieldChange(this.dataset.worksheetName, this.dataset.uiAnchor, this)">@Model?.Field?.CurrentValue?.ConvertInputValueOrNull(Model.Field.Type)</textarea>
}
