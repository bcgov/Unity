@model Unity.Notifications.Web.Views.Settings.NotificationsSettingGroup.NotificationsSettingViewModel

<div class="container-fluid px-0">
    <nav>
        <div class="nav nav-tabs" id="nav-tab" role="tablist">
            <button class="nav-link active" id="nav-mapping-tab" data-bs-toggle="tab" data-bs-target="#nav-config" type="button" role="tab">
                Notifications Configuration
            </button>
            <button class="nav-link" id="nav-template-tab" data-bs-toggle="tab" data-bs-target="#nav-template" type="button" role="tab">
                Email Templates
            </button>
            <button class="nav-link" id="nav-internal-email-group-tab" data-bs-toggle="tab" data-bs-target="#nav-internal-email-group" type="button" role="tab">
                Internal Email Group
            </button>
        </div>
    </nav>

    <div class="tab-content unt-tab-content" id="nav-tabContent">

        <!-- Notifications Configuration -->
        <div class="tab-pane fade show active" id="nav-config" role="tabpanel" aria-labelledby="nav-mapping-tab">
            <div class="row">
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="m-0"><b>Email Addresses</b></h5>
                        <button id="AddEmailAddress" class="btn btn-primary" type="button" title="Add Email Address">
                            <span>+ Add Email Address</span>
                        </button>
                    </div>
                    <abp-table id="EmailAddressesTable" data-resize-aware="true"></abp-table>

                    <hr class="my-4" />
                    <form id="NotificationsSettingsForm">
                        <abp-row>
                            <abp-column size-md="_12" class="mx-2 fw-bold">
                                <abp-input asp-for="MaximumRetryAttempts" />
                            </abp-column>
                        </abp-row>

                        <abp-row>
                            <abp-column size-md="_12" class="mx-2 fw-bold">
                                <abp-input asp-for="EnableEmailDelay" />
                            </abp-column>
                        </abp-row>

                        <abp-row>
                            <hr class="my-4" />
                            <div class="d-flex p-2">
                                <abp-button id="NotificationsSaveButton"
                                            text="Save Changes"
                                            button-type="Primary"
                                            class="me-2"
                                            type="submit" />

                                <abp-button id="NotificationsDiscardButton"
                                            text="Discard Changes"
                                            button-type="Light"
                                            class="me-2"
                                            disabled="true" />
                            </div>
                        </abp-row>
                    </form>
                </div>
            </div>
        </div>

        <!-- Email Templates -->
        <div class="tab-pane fade" id="nav-template" role="tabpanel" aria-labelledby="nav-template-tab">
            <input type="hidden" id="AllowedFileTypes" value="@Model.AllowedFileTypes" />
            <input type="hidden" id="MaxFileSize" value="@Model.MaxFileSize" />
            <input type="hidden" id="EmailAttachmentMaxFileSize" value="@Model.EmailAttachmentMaxFileSize" />
            <input type="hidden" id="TotalEmailAttachmentMaxFileSize" value="@Model.TotalEmailAttachmentMaxFileSize" />

            <div class="row">
                @await Html.PartialAsync("/Views/Settings/NotificationsSettingGroup/_Templates.cshtml")      
            </div>
        </div>

        <!-- Internal Email Groups -->
        <div class="tab-pane fade" id="nav-internal-email-group" role="tabpanel" aria-labelledby="nav-internal-email-group-tab">
            <div class="row">
                <div class="container mt-3">
                    <div class="unity-setting-body p-3">
                        <div class="row">
                            <div class="container">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="m-0"><b>Email Groups</b></h5>
                                    <button id="CreateNewEmailGroup"
                                            class="btn btn-primary"
                                            type="button"
                                            title="Create">
                                        <span>+ ADD Email Group</span>
                                    </button>
                                </div>

                                <abp-table id="EmailGroupsTable" data-resize-aware="true"></abp-table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="emailAddressModal" tabindex="-1" aria-labelledby="emailAddressModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="emailAddressModalTitle">Email Address</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="configuredEmailForm">
                <div class="modal-body">
                    <label class="form-label" for="configuredEmailAddress">Email Address</label>
                    <input id="configuredEmailAddress" name="configuredEmailAddress" class="email-input from-input form-control" type="text" required />

                    <label class="form-label mt-3" for="configuredEmailType">Email Type</label>
                    <select id="configuredEmailType" class="form-select">
                        <option value="Sender">Sender Address</option>
                        <option value="ReplyTo">Reply-to Address</option>
                        <option value="NoReply">No-reply Address</option>
                        <option value="Inbound">Inbound Address</option>
                        <option value="Support">Support Address</option>
                        <option value="Other">Other</option>
                    </select>

                    <label class="form-label mt-3" for="configuredEmailDescription">Description</label>
                    <textarea id="configuredEmailDescription" class="form-control"></textarea>

                    <div class="configured-email-use-note mt-3">
                        <div class="configured-email-options">
                            <div class="form-check">
                                <input id="configuredEmailDefault" class="form-check-input" type="checkbox" />
                                <label class="form-check-label" for="configuredEmailDefault">Default</label>
                            </div>
                            <div class="form-check">
                                <input id="configuredEmailActive" class="form-check-input" type="checkbox" />
                                <label class="form-check-label" for="configuredEmailActive">Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="configured-email-warning mt-3" role="note">
                        <strong>Email Address In Use</strong>
                        <p class="mb-0">If this email address is currently associated with one or more active Email Templates and/or Form-Level Notification Plans, updating the email address will <strong>not</strong> automatically update any existing templates or notification plans that use it.</p>
                        <p class="mb-0 mt-2">To ensure those configurations use the new email address, you must manually update the <strong>From</strong> email address within each associated Email Template or Form-Level Notification Plan.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" id="saveConfiguredEmail">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
