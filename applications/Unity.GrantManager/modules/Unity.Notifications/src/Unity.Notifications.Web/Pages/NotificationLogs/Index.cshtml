@page
@using Microsoft.Extensions.Localization
@using Unity.Notifications.Localization
@model Unity.Notifications.Web.Pages.NotificationLogs.IndexModel
@inject IStringLocalizer<NotificationsResource> L

@section scripts {
    <abp-script-bundle>
        <abp-script src="/Pages/NotificationLogs/Index.js" />
    </abp-script-bundle>
}

<div class="container-fluid px-2 action-bar-date-controls">
    <div class="action-bar p-2 search-action-bar">
        <div class="search-action-bar_search-wrapper">
            <label for="search" class="visually-hidden">@L["Search"]</label>
            <input type="search" id="search" class="tbl-search" placeholder="@L["Search"]" aria-label="@L["Search"]" />

            <div class="mb-3 date-input-filter-div">
                <label class="form-label" for="quickDateRange">@L["NotificationList:QuickDateRange"]</label>
                <select id="quickDateRange" class="form-control quick-date-input">
                    <option value="today">@L["NotificationList:DateRange:Today"]</option>
                    <option value="last7days">@L["NotificationList:DateRange:Last7Days"]</option>
                    <option value="last30days">@L["NotificationList:DateRange:Last30Days"]</option>
                    <option value="last3months">@L["NotificationList:DateRange:Last3Months"]</option>
                    <option value="last6months" selected>@L["NotificationList:DateRange:Last6Months"]</option>
                    <option value="alltime">@L["NotificationList:DateRange:AllTime"]</option>
                    <option value="custom">@L["NotificationList:DateRange:Custom"]</option>
                </select>
            </div>

            <div class="mb-3 custom-date-range-container-div" id="customDateInputs" style="display: none;">
                <div class="mb-3 date-input-filter-div">
                    <label class="form-label" for="fromDate">@L["NotificationList:DateFrom"]</label>
                    <input abp-data-datepicker="false"
                           type="date"
                           id="fromDate"
                           class="form-control date-input-filter"
                           min="1900-01-01"
                           max="2100-01-01">
                </div>
                <div class="mb-3 date-input-filter-div">
                    <label class="form-label" for="toDate">@L["NotificationList:DateTo"]</label>
                    <input abp-data-datepicker="false"
                           type="date"
                           id="toDate"
                           class="form-control date-input-filter"
                           min="1900-01-01"
                           max="2100-01-01">
                </div>
            </div>

            <div class="mb-3 date-input-filter-div">
                <label class="form-label" for="typeFilter">@L["NotificationLogs:Type"]</label>
                <select id="typeFilter" class="form-control quick-date-input">
                    <option value="">@L["NotificationLogs:All"]</option>
                </select>
            </div>

            <div class="mb-3 date-input-filter-div">
                <label class="form-label" for="severityFilter">@L["NotificationLogs:Severity"]</label>
                <select id="severityFilter" class="form-control quick-date-input">
                    <option value="">@L["NotificationLogs:All"]</option>
                    <option value="0">Info</option>
                    <option value="1">Warning</option>
                    <option value="2">Error</option>
                    <option value="3">Critical</option>
                </select>
            </div>

            <div class="mb-3 date-input-filter-div">
                <label class="form-label" for="channelFilter">@L["NotificationLogs:Channel"]</label>
                <select id="channelFilter" class="form-control quick-date-input">
                    <option value="">@L["NotificationLogs:All"]</option>
                    <option value="0">SignalR</option>
                    <option value="1">ExceptionPipeline</option>
                    <option value="2">Prometheus</option>
                    <option value="3">System</option>
                </select>
            </div>

            <div class="mb-3 date-input-filter-div">
                <label class="form-label" for="tenantFilter">@L["NotificationLogs:Tenant"]</label>
                <input type="text" id="tenantFilter" class="form-control" placeholder="GUID" />
            </div>

            <div class="mb-3 date-input-filter-div">
                <label class="form-label" for="userFilter">@L["NotificationLogs:User"]</label>
                <input type="text" id="userFilter" class="form-control" placeholder="GUID" />
            </div>
        </div>
        <span id="dynamicButtonContainerId"></span>
    </div>

    <abp-table id="NotificationLogsTable"></abp-table>
</div>
