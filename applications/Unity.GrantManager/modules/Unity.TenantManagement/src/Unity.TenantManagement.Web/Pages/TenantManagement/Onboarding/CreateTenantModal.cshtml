@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Unity.GrantManager.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Unity.TenantManagement
@using Unity.TenantManagement.Web.Pages.TenantManagement.Onboarding
@model CreateTenantModalModel
@inject IHtmlLocalizer<GrantManagerResource> L
@{
    Layout = null;
}
<abp-modal size="Large">
    <abp-modal-header title="@L["CreateTenantModal:Title"].Value"></abp-modal-header>
    <abp-modal-body>

        <script id="create-tenant-fields-json" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OnboardingRequest!.Fields))</script>

        <ul class="nav nav-tabs mb-3" id="createTenantModalTabs">
            <li class="nav-item">
                <button class="nav-link active" id="ctm-tab-details" data-bs-toggle="tab"
                        data-bs-target="#ctm-pane-details" type="button"
                        aria-controls="ctm-pane-details">
                    @L["CreateTenantModal:DetailsTab"]
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="ctm-tab-metabase" data-bs-toggle="tab"
                        data-bs-target="#ctm-pane-metabase" type="button"
                        aria-controls="ctm-pane-metabase">
                    @L["CreateTenantModal:MetabaseTab"]
                </button>
            </li>
        </ul>

        <div class="tab-content" id="createTenantModalTabContent">
        <div class="tab-pane fade show active" id="ctm-pane-details" aria-labelledby="ctm-tab-details">

        <div id="create-tenant-field-mapping" style="display:none;">
            <div class="row g-2 mb-3">
                <div class="col-12">
                    <label for="create-tenant-tenant-name-field" class="form-label small mb-1">@L["CreateTenantModal:TenantNameFieldLabel"]</label>
                    <div class="input-group input-group-sm">
                        <select id="create-tenant-tenant-name-field" class="form-select form-select-sm" style="flex:0 0 50%;">
                            <option value="">@L["CreateTenantModal:MappingPlaceholder"]</option>
                        </select>
                        <span id="create-tenant-tenant-name-value" class="input-group-text text-muted fst-italic" style="flex:0 0 50%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
                    </div>
                </div>
                <div class="col-12">
                    <label for="create-tenant-display-name-field" class="form-label small mb-1">@L["CreateTenantModal:DisplayNameFieldLabel"]</label>
                    <div class="input-group input-group-sm">
                        <select id="create-tenant-display-name-field" class="form-select form-select-sm" style="flex:0 0 50%;">
                            <option value="">@L["CreateTenantModal:MappingPlaceholder"]</option>
                        </select>
                        <span id="create-tenant-display-name-value" class="input-group-text text-muted fst-italic" style="flex:0 0 50%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
                    </div>
                </div>
                <div class="col-12">
                    <label for="create-tenant-ministry-field" class="form-label small mb-1">@L["CreateTenantModal:Ministry"]</label>
                    <div class="input-group input-group-sm">
                        <select id="create-tenant-ministry-field" class="form-select form-select-sm" style="flex:0 0 50%;">
                            <option value="">@L["CreateTenantModal:MappingPlaceholder"]</option>
                        </select>
                        <span id="create-tenant-ministry-value" class="input-group-text text-muted fst-italic" style="flex:0 0 50%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
                    </div>
                </div>
                <div class="col-12">
                    <label for="create-tenant-division-field" class="form-label small mb-1">@L["CreateTenantModal:Division"]</label>
                    <div class="input-group input-group-sm">
                        <select id="create-tenant-division-field" class="form-select form-select-sm" style="flex:0 0 50%;">
                            <option value="">@L["CreateTenantModal:MappingPlaceholder"]</option>
                        </select>
                        <span id="create-tenant-division-value" class="input-group-text text-muted fst-italic" style="flex:0 0 50%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
                    </div>
                </div>
                <div class="col-12">
                    <label for="create-tenant-branch-field" class="form-label small mb-1">@L["CreateTenantModal:Branch"]</label>
                    <div class="input-group input-group-sm">
                        <select id="create-tenant-branch-field" class="form-select form-select-sm" style="flex:0 0 50%;">
                            <option value="">@L["CreateTenantModal:MappingPlaceholder"]</option>
                        </select>
                        <span id="create-tenant-branch-value" class="input-group-text text-muted fst-italic" style="flex:0 0 50%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
                    </div>
                </div>
                <div class="col-12">
                    <label for="create-tenant-program-area-field" class="form-label small mb-1">@L["CreateTenantModal:ProgramArea"]</label>
                    <div class="input-group input-group-sm">
                        <select id="create-tenant-program-area-field" class="form-select form-select-sm" style="flex:0 0 50%;">
                            <option value="">@L["CreateTenantModal:MappingPlaceholder"]</option>
                        </select>
                        <span id="create-tenant-program-area-value" class="input-group-text text-muted fst-italic" style="flex:0 0 50%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
                    </div>
                </div>
                <div class="col-12">
                    <label for="create-tenant-features-field" class="form-label small mb-1">@L["CreateTenantModal:Features"]</label>
                    <div class="input-group input-group-sm" style="align-items:flex-start;">
                        <select id="create-tenant-features-field" class="form-select form-select-sm" style="flex:0 0 50%;">
                            <option value="">@L["CreateTenantModal:MappingPlaceholder"]</option>
                        </select>
                        <span id="create-tenant-features-value" class="input-group-text" style="flex:0 0 50%; height:auto; flex-wrap:wrap; row-gap:4px;"></span>
                    </div>
                </div>
                <div class="col-12">
                    <label for="create-tenant-super-users-field" class="form-label small mb-1">@L["CreateTenantModal:SuperUsersFieldLabel"]</label>
                    <div class="input-group input-group-sm" style="align-items:flex-start;">
                        <select id="create-tenant-super-users-field" class="form-select form-select-sm" style="flex:0 0 50%;">
                            <option value="">@L["CreateTenantModal:MappingPlaceholder"]</option>
                        </select>
                        <span id="create-tenant-super-users-value" class="input-group-text text-muted fst-italic" style="flex:0 0 50%; display:block; height:auto; white-space:normal; overflow-wrap:break-word;"></span>
                    </div>
                </div>
            </div>
        </div>

        </div>

        <div class="tab-pane fade" id="ctm-pane-metabase" aria-labelledby="ctm-tab-metabase">
            <p class="text-muted small">@L["CreateTenantModal:MetabaseDescription"]</p>
            <p class="text-muted small">@L["CreateTenantModal:MetabaseAccountNote"]</p>

            <div id="create-tenant-metabase-user-list" class="mb-3">
                @foreach (var email in Model.DefaultMetabaseUserEmails)
                {
                    <div class="form-check d-flex align-items-center">
                        <input class="form-check-input create-tenant-metabase-user-checkbox" type="checkbox" value="@email" id="create-tenant-metabase-user-@email.GetHashCode()" checked>
                        <label class="form-check-label flex-grow-1" for="create-tenant-metabase-user-@email.GetHashCode()">@email</label>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2 create-tenant-metabase-remove-default-btn" data-email="@email" title="@L["CreateTenantModal:MetabaseRemoveDefaultTitle"]" aria-label="@L["CreateTenantModal:MetabaseRemoveDefaultTitle"]">&times;</button>
                    </div>
                }
            </div>

            <div class="input-group input-group-sm mb-2" style="max-width: 420px;">
                <input type="email" id="create-tenant-metabase-new-user-email" class="form-control" placeholder="name@gov.bc.ca" aria-label="New Metabase user email" />
                <button type="button" id="create-tenant-metabase-add-user-btn" class="btn btn-outline-secondary">@L["CreateTenantModal:MetabaseAddButton"]</button>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="create-tenant-metabase-save-as-default">
                <label class="form-check-label" for="create-tenant-metabase-save-as-default">@L["CreateTenantModal:MetabaseSaveAsDefaultLabel"]</label>
            </div>

            <input type="hidden" id="create-tenant-metabase-user-emails" />
            <input type="hidden" id="create-tenant-metabase-new-default-user-emails" />
            <input type="hidden" id="create-tenant-metabase-removed-default-user-emails" />
        </div>

        </div>

        <div id="onboarding-validation-loading" class="text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span>
            @L["CreateTenantModal:Validating"]
        </div>
        <div id="onboarding-validation-result" class="d-none"></div>

        <div id="onboarding-creating" class="d-none mt-3">
            <div class="d-flex align-items-center text-muted mb-2">
                <span class="spinner-border spinner-border-sm me-2"></span>
                @L["CreateTenantModal:CreatingSpinner"]
            </div>
            <div class="alert alert-info mb-0 small">
                <strong>@L["CreateTenantModal:CreatingWarningTitle"]</strong>
                @L["CreateTenantModal:CreatingWarningBody"]
            </div>
        </div>

    </abp-modal-body>
    <abp-modal-footer>
        <button type="button" id="btn-confirm-create-tenant" class="btn btn-primary" disabled>
            @L["CreateTenantModal:ConfirmButton"]
        </button>
        <button type="button" id="btn-cancel-create-tenant" class="btn btn-secondary" data-bs-dismiss="modal">
            @L["Common:Command:Cancel"]
        </button>
    </abp-modal-footer>
</abp-modal>
