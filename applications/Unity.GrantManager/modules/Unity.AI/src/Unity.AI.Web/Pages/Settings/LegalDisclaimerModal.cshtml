@page
@using Unity.AI.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Unity.AI.Web.Pages.Settings.LegalDisclaimerModalModel
@inject IStringLocalizer<AIResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/Settings/LegalDisclaimerModal">
    <abp-modal>
        <abp-modal-header title="@L["LegalDisclaimer:Title"].Value"></abp-modal-header>
        <abp-modal-body>
            @L["LegalDisclaimer:Body"].Value
        </abp-modal-body>
        <abp-modal-footer>
            <button class="btn btn-primary" data-busy-text="@L["LegalDisclaimer:Confirming"].Value" type="submit">@L["LegalDisclaimer:Confirm"].Value</button>
            <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">@AbpModalButtons.Cancel</button>
        </abp-modal-footer>
    </abp-modal>
</form>
