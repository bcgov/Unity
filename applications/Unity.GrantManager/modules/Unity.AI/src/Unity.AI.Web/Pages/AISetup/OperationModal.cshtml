@page
@using Unity.AI.Localization
@using Unity.AI.Web.Pages.AISetup
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model OperationModalModel
@inject IStringLocalizer<AIResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/AISetup/OperationModal">
    <abp-modal>
        <abp-modal-header title="@(Model.IsAIReporting
            ? (Model.IsAIReportingEmbedding ? L["AISetup:EditAIReportingEmbedding"].Value : L["AISetup:EditAIReportingChat"].Value)
            : $"{L["AISetup:EditOperation"].Value}: {Model.Name}")"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Name" />
            @if (Model.ModelOptions.Count == 0)
            {
                <div class="alert alert-warning mb-3">@L["AISetup:NoActiveModels"]</div>
            }
            @if (Model.IsAIReportingEmbedding)
            {
                <div class="alert alert-warning mb-3">@L["AISetup:EmbeddingChangeWarning"]</div>
            }
            <abp-select asp-for="Operation.AIModelId" asp-items="Model.ModelOptions" />
            @if (Model.IsAIReporting)
            {
                @* AI Reporting is always Sequential and active. *@
                <input type="hidden" asp-for="Operation.ExecutionMode" />
                <input type="hidden" name="Operation.IsActive" value="true" />
            }
            else if (Model.UsesExecutionMode)
            {
                <abp-select asp-for="Operation.ExecutionMode" asp-items="Model.ExecutionModeOptions" info="@L["AISetup:ExecutionModeHelp"].Value" />
            }
            else
            {
                @* This operation always runs Sequential: no field, since there is no choice to make. *@
                <input type="hidden" asp-for="Operation.ExecutionMode" />
            }
            @if (!Model.IsAIReporting)
            {
                <abp-input asp-for="Operation.IsActive" />
            }
        </abp-modal-body>
        <abp-modal-footer>
            <button class="btn btn-primary" data-busy-text="Saving..." type="submit">Save</button>
            <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Cancel</button>
        </abp-modal-footer>
    </abp-modal>
</form>
