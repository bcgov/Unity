@page
@using Unity.AI.Localization
@using Unity.AI.Web.Pages.AISetup
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model ModelModalModel
@inject IStringLocalizer<AIResource> L
@{
    Layout = null;
}

<form method="post" asp-page="/AISetup/ModelModal">
    <abp-modal>
        <abp-modal-header title="@(Model.IsNew ? L["AISetup:NewModel"].Value : L["AISetup:EditModel"].Value)"></abp-modal-header>
        <abp-modal-body>
            <abp-input asp-for="Id" />
            <abp-input asp-for="Input.Name" info="@L["AISetup:NameHelp"].Value" />
            @* Azure OpenAI is the only provider, so it is not offered as a choice. *@
            <input type="hidden" asp-for="Input.Provider" />
            <abp-input asp-for="Input.IsActive" />
        </abp-modal-body>
        <abp-modal-footer>
            <button class="btn btn-primary" data-busy-text="Saving..." type="submit">Save</button>
            <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Cancel</button>
        </abp-modal-footer>
    </abp-modal>
</form>
