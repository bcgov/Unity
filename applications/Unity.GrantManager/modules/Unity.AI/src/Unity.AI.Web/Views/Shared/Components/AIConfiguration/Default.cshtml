@using Unity.AI.Web.Views.Shared.Components.AIConfiguration
@model AIConfigurationViewModel

@{
    Layout = null;
}

<input type="hidden" id="aiConfigFormId" value="@Model.ApplicationFormId" />

<div class="ai-configuration-container">
    <div class="configuration-action-bar row px-0">
        <div class="col-12 col-md-8">
            <h5>AI Configuration</h5>
        </div>
        <div class="col-12 col-md-4 btn-wrapper">
            <abp-button id="btn-save-ai-config"
                        text="Save"
                        icon-type="Other"
                        icon="fl fl-save"
                        class="btn unt-btn-primary btn-primary"
                        button-type="Primary" />
            <abp-button id="btn-cancel-ai-config"
                        class="btn unt-btn-outline-primary btn-outline-primary mx-1"
                        icon-type="Other" icon="fl fl-undo"
                        text="Cancel"
                        abp-tooltip="Cancel changes" />
            <abp-button id="btn-back-ai-config" text="Back"
                        class="btn unt-btn-outline-primary btn-outline-primary"
                        abp-tooltip="Navigate back to the Forms" />
        </div>
    </div>
    <div class="row">
        <div class="col-12 p-3">
            @if (Model.ShowAutomatic)
            {
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input"
                           type="checkbox"
                           id="AutomaticallyGenerateAIAnalysis"
                           name="AutomaticallyGenerateAIAnalysis"
                           @(Model.AutomaticallyGenerateAIAnalysis ? "checked" : "") />
                    <label class="form-check-label fw-bold" for="AutomaticallyGenerateAIAnalysis">
                        Automatically Generate AI Analysis
                    </label>
                    <div class="text-muted small">
                        When enabled, all AI analysis features run automatically when a new application is submitted through this form.
                        Requires tenant-level Automatic AI Generation to also be enabled.
                    </div>
                </div>
            }

            @if (Model.ShowManual)
            {
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input"
                           type="checkbox"
                           id="ManuallyInitiateAIAnalysis"
                           name="ManuallyInitiateAIAnalysis"
                           @(Model.ManuallyInitiateAIAnalysis ? "checked" : "") />
                    <label class="form-check-label fw-bold" for="ManuallyInitiateAIAnalysis">
                        Manually Initiate AI Analysis
                    </label>
                    <div class="text-muted small">
                        When enabled, users with appropriate permissions can manually generate or regenerate AI analysis for applications submitted through this form.
                        Includes: AI Attachment Summary, Application Analysis, AI Scoring.
                    </div>
                </div>
            }
        </div>
    </div>
</div>
