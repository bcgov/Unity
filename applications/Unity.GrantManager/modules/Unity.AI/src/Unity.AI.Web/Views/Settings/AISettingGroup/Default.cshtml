@using Microsoft.Extensions.Localization
@using Unity.AI.Localization
@model Unity.AI.Web.Views.Settings.AISettingGroup.AISettingViewModel
@inject IStringLocalizer<AIResource> L

<div class="container-fluid px-0">
    <div class="unity-page-titlebar">
        <h4 class="m-0">@L["AISettingGroup:Title"]</h4>
    </div>

    <div class="row">
        <div class="p-3">
            <form id="AISettingsForm">
                <abp-row>
                    <abp-column size-md="_12" class="mx-2">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="AutomaticGenerationEnabled"
                                   name="AutomaticGenerationEnabled"
                                   value="true"
                                   @(Model.AutomaticGenerationEnabled ? "checked" : "") />
                            <label class="form-check-label fw-bold" for="AutomaticGenerationEnabled">
                                @L["Setting:AI.AutomaticGenerationEnabled"]
                            </label>
                            <div class="text-muted small">
                                @L["Setting:AI.AutomaticGenerationEnabled:Description"]
                            </div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="ManualGenerationEnabled"
                                   name="ManualGenerationEnabled"
                                   value="true"
                                   @(Model.ManualGenerationEnabled ? "checked" : "") />
                            <label class="form-check-label fw-bold" for="ManualGenerationEnabled">
                                @L["Setting:AI.ManualGenerationEnabled"]
                            </label>
                            <div class="text-muted small">
                                @L["Setting:AI.ManualGenerationEnabled:Description"]
                            </div>
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="ReportingEnabled"
                                   name="ReportingEnabled"
                                   value="true"
                                   @(Model.ReportingEnabled ? "checked" : "") />
                            <label class="form-check-label fw-bold" for="ReportingEnabled">
                                @L["Setting:AI.ReportingEnabled"]
                            </label>
                            <div class="text-muted small">
                                @L["Setting:AI.ReportingEnabled:Description"]
                            </div>
                        </div>
                    </abp-column>
                </abp-row>

                <abp-row>
                    <hr class="my-4" />
                    <div class="d-flex p-2">
                        <abp-button id="AISettingsSaveButton"
                                    text="@L["AISettingGroup:SaveChanges"].Value"
                                    button-type="Primary"
                                    class="me-2"
                                    type="submit" />

                        <abp-button id="AISettingsDiscardButton"
                                    text="@L["AISettingGroup:DiscardChanges"].Value"
                                    button-type="Light"
                                    class="me-2"
                                    disabled="true" />
                    </div>
                </abp-row>
            </form>
        </div>
    </div>
</div>
