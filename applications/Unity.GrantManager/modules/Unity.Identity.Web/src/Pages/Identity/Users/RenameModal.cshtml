@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Unity.GrantManager.Localization
@using Unity.Identity.Web.Pages.Identity.Users

@model RenameModalModel

@inject IHtmlLocalizer<GrantManagerResource> L
@{
    Layout = null;
}
<form asp-page="/Identity/Users/RenameModal" data-check-form-on-close="false">
    <abp-modal centered="true" scrollable="true" size="ExtraLarge">
        <abp-modal-header title="@L["UnityIdentity:RenameUser"].Value"></abp-modal-header>
        <abp-modal-body>
            <input type="hidden" id="rename-user-id" asp-for="RenameInfo.UserId" />
            <input type="hidden" id="rename-user-candidate-id" asp-for="RenameInfo.UserIdentifier" />
            <h6>@L["UnityIdentity:CurrentUser"].Value</h6>
            <abp-row>
                <abp-column size="_3"><abp-input id="rename-current-firstName" asp-for="RenameInfo.FirstName" disabled readonly="true" /></abp-column>
                <abp-column size="_3"><abp-input id="rename-current-lastName" asp-for="RenameInfo.LastName" disabled readonly="true" /></abp-column>
                <abp-column size="_3"><abp-input id="rename-current-userName" asp-for="RenameInfo.UserName" disabled readonly="true" /></abp-column>
                <abp-column size="_3"><abp-input id="rename-current-email" asp-for="RenameInfo.Email" disabled readonly="true" /></abp-column>
            </abp-row>
            <abp-input id="rename-current-displayName" asp-for="RenameInfo.DisplayName" disabled readonly="true" />
            <abp-input id="rename-current-badge" asp-for="RenameInfo.Badge" disabled readonly="true" />
            <div id="rename-differences" class="mt-3"></div>
        </abp-modal-body>
        <abp-modal-footer>
            <abp-button id="rename-user-btn" text="@L["UnityIdentity:Replace"].Value" type="submit" button-type="Primary" disabled="true"></abp-button>
            <abp-button id="cancel-rename-btn" class="close" data-bs-dismiss="modal" aria-label="Close" text="@L["Cancel"].Value" button-type="Secondary"></abp-button>
        </abp-modal-footer>
    </abp-modal>
</form>
