@using Microsoft.AspNetCore.Authorization;
@using Microsoft.Extensions.Localization;
@using Unity.GrantManager.Localization;
@using Unity.GrantManager.Permissions
@using Unity.Modules.Shared
@using Volo.Abp.Authorization.Permissions;

@inject IStringLocalizer<GrantManagerResource> L
@inject IAuthorizationService AuthorizationService
@inject IPermissionChecker PermissionChecker

@{
    var hasViewApplicant = await PermissionChecker.IsGrantedAsync(UnitySelector.ApplicantManagement.Applicant.Default);
    var hasMergeApplicant = await PermissionChecker.IsGrantedAsync(UnitySelector.ApplicantManagement.Applicant.Merge);
    var hasDeleteApplicant = await PermissionChecker.IsGrantedAsync(UnitySelector.ApplicantManagement.Applicant.Delete);
}

<div class="action-bar p-2 search-action-bar">
    <div class="search-action-bar_search-wrapper">
        <input type="search" id="search" placeholder="@L["Common:Command:Search"].Value" aria-label="@L["Common:Command:Search"].Value" class="tbl-search">
    </div>

    <div class="btn-group" id="app_custom_buttons">
        <abp-button id="openApplicant"
                    text="@L["ApplicationList:OpenButton"].Value"
                    data-selector="applicants-table-actions"
                    class="custom-table-btn flex-none btn btn-secondary action-bar-btn-unavailable"
                    button-type="Secondary"
                    abp-if="@hasViewApplicant" />
        <abp-button id="mergeApplicants"
                    text="Merge"
                    data-selector="applicants-table-actions"
                    class="custom-table-btn flex-none btn btn-secondary d-none"
                    button-type="Secondary"
                    abp-if="@hasMergeApplicant" />
        <abp-button id="deleteApplicant"
                    text="Delete"
                    data-selector="applicants-table-actions"
                    class="custom-table-btn flex-none btn btn-secondary action-bar-btn-unavailable"
                    button-type="Secondary"
                    abp-if="@hasDeleteApplicant" />
    </div>

    @* Spacer to align buttons properly *@
    <span id="dynamicButtonContainerId"></span>
</div>

@await Html.PartialAsync("~/Views/Shared/Components/ApplicantsActionBar/ListMerge.cshtml")