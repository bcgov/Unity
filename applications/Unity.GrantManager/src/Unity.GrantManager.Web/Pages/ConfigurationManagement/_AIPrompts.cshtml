<div class="container-fluid px-0">
    <div class="action-bar p-2 filter-search-action-bar">
        <div class="unity-page-titlebar">
            <h4>AI Prompts</h4>
        </div>
        <div class="filter-search-action-bar_search-wrapper">
            <input type="search" id="search-prompts" placeholder="Search" aria-label="Search prompts" class="tbl-search">
        </div>
        <div id="ai-prompts-dynamic-buttons" class="dynamic-buttons-div button-gap-1"></div>
    </div>
    <div id="promptsSplitContainer" class="prompts-split-container px-3 pb-3">
        <div id="promptsLeftPane" class="prompts-left-pane">
            <div>
                <div class="card-body p-2">
                    <abp-table id="AIPromptsTable" striped-rows="false" class="nowrap"></abp-table>
                </div>
            </div>
        </div>
        <div id="promptsDivider" class="prompts-split-divider" title="Drag to resize"></div>
        <div id="promptsRightPane" class="prompts-right-pane" style="display:none;">
            <div class="d-flex flex-column">
                <div class="card-header version-editor-header py-2">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <strong id="versionEditorTitle" class="text-truncate me-1" style="max-width:160px;"></strong>
                        <label for="versionSelect" class="mb-0 small text-muted">Version:</label>
                        <select id="versionSelect" class="form-select form-select-sm version-select"></select>
                        <button id="newVersionBtn" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-plus"></i> New Version</button>
                        <button id="saveVersionBtn" class="btn btn-sm btn-primary ms-auto"><span id="saveVersionBtnLabel">Save Version</span></button>
                    </div>
                </div>
                <div class="card-body version-editor-body overflow-auto">
                    <form id="versionEditForm" autocomplete="off">
                        <input type="hidden" id="versionId" />
                        <input type="hidden" id="versionPromptId" />
                        <input type="hidden" id="versionNumber" />
                        <div class="row g-3">
                            <div class="col-12">
                                <label for="versionSystemPrompt" class="form-label small fw-semibold mb-1">System Prompt <span class="text-danger">*</span></label>
                                <textarea id="versionSystemPrompt" class="form-control version-textarea version-textarea--code" rows="7" spellcheck="false"></textarea>
                            </div>
                            <div class="col-12">
                                <label for="versionUserPrompt" class="form-label small fw-semibold mb-1">User Prompt <span class="text-danger">*</span></label>
                                <textarea id="versionUserPrompt" class="form-control version-textarea version-textarea--code" rows="7" spellcheck="false"></textarea>
                            </div>
                            <div class="col-6 col-sm-3 d-flex align-items-end pb-1">
                                <div class="form-check">
                                    <input type="checkbox" id="versionIsActive" class="form-check-input" checked="checked" />
                                    <label class="form-check-label small" for="versionIsActive">Prompt is active</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <label for="versionMetadataJson" class="form-label small fw-semibold mb-0">Metadata JSON</label>
                                    <button type="button" id="formatJsonBtn" class="btn btn-link btn-sm p-0 ms-1" title="Format JSON"><i class="fa-solid fa-indent"></i> Format</button>
                                    <span id="jsonValidationMsg" class="small text-danger ms-1" style="display:none;"></span>
                                </div>
                                <textarea id="versionMetadataJson" class="form-control version-textarea version-textarea--json" rows="10"></textarea>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
