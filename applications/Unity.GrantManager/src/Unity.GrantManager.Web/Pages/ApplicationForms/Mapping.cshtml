@page
@using Unity.GrantManager.ApplicationForms
@using Unity.Reporting.Permissions
@using Volo.Abp.AspNetCore.Mvc.UI.Layout;
@using Unity.GrantManager.Web.Pages.ApplicationForms;
@using Unity.GrantManager.Permissions;
@using Unity.Notifications.Permissions;
@using Unity.AI.Permissions;

@using Volo.Abp.Authorization.Permissions;
@using Unity.GrantManager.Web.Views.Shared.Components.Notifications;
@using Unity.GrantManager.Web.Views.Shared.Components.ApplicationFormConfigWidget;
@using Volo.Abp.Features

@model MappingModel
@inject IPageLayout PageLayout
@inject IPermissionChecker PermissionChecker
@inject IFeatureChecker FeatureChecker

@{
    PageLayout.Content.MenuItemName = "GrantManager.ApplicationForms";
    PageLayout.Content.Title = "Application Mapping";
    ViewBag.PageTitle = "Application Forms Mapping";
}
@section scripts
{
    <abp-script src="/Views/Shared/Components/_Shared/string-utils.js" />
    <abp-script src="/Pages/ApplicationForms/mapping-utils.js" />
    <abp-script src="/Pages/GrantApplications/ai-generation-button-state.js" />
    <abp-script src="/Pages/GrantApplications/ai-rate-limit.js" />
    <abp-script src="/Pages/ApplicationForms/Mapping.js" />
    <abp-script src="/Pages/SettingManagement/zone-management.js" />
}

@section styles {
    <abp-style src="/Pages/ApplicationForms/Mapping.css" />
    <abp-style src="/Views/Shared/Components/CustomFields/Default.css" />
}

<input type="hidden" id="intakeProperties" value="@Model.IntakeProperties" />
<input type="hidden" id="applicationFormVersionDtoString" value="@Model.ApplicationFormVersionDtoString" />
<input type="hidden" id="availableChefsFields" value="@Model.ApplicationFormVersionDto?.AvailableChefsFields" />
<input type="hidden" id="existingMapping" value="@Model.ApplicationFormVersionDto?.SubmissionHeaderMapping" />
<input type="hidden" id="formVersionId" value="@Model.ApplicationFormVersionDto?.Id" />
<input type="hidden" id="applicationFormId" value="@Model.ApplicationFormDto?.Id" />
<input type="hidden" id="chefsFormId" value="@Model.ApplicationFormDto?.ChefsApplicationFormGuid" />
<input type="hidden" id="formName" value="@Model.ApplicationFormDto?.ApplicationFormName" />

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h5 class="label unt-label" id="applicationFormName">@Model.ApplicationFormDto?.ApplicationFormName</h5>
        </div>
    </div>
    <!--Tab list -->
    <nav aria-label="Application form configuration tabs">
        <div class="nav nav-tabs" id="nav-tab" role="tablist">
            <button class="nav-link active" id="nav-mapping-tab" data-bs-toggle="tab" data-bs-target="#nav-mapping" type="button" role="tab">
                Mapping
            </button>
            <button class="nav-link" id="nav-custom-fields-tab" data-bs-toggle="tab" data-bs-target="#nav-custom-fields" type="button" role="tab">
                Scoresheet & Worksheets
            </button>
            @if (await PermissionChecker.IsGrantedAsync(UnitySettingManagementPermissions.UserInterface))
            {
                <button class="nav-link" id="nav-ui-configuration-tab" data-bs-toggle="tab" data-bs-target="#nav-ui-configuration" type="button" role="tab">
                    User Interface
                </button>
            }
            @if (await FeatureChecker.IsEnabledAsync("Unity.Payments"))
            {
                <button class="nav-link" id="nav-payment-configuration-tab" data-bs-toggle="tab" data-bs-target="#nav-payment-configuration" type="button" role="tab">
                    Payment
                </button>
            }
            @if (await FeatureChecker.IsEnabledAsync("Unity.Reporting")
                        && await PermissionChecker.IsGrantedAsync(ReportingPermissions.Configuration.Default))
            {
                <button class="nav-link" id="nav-reporting-configuration-tab" data-bs-toggle="tab"
                    data-bs-target="#nav-reporting-configuration" type="button" role="tab">Reporting Configuration</button>
            }
            <button class="nav-link" id="nav-other-configuration-tab" data-bs-toggle="tab"
                data-bs-target="#nav-other-configuration" type="button" role="tab">Other Configuration</button>
                
            @if (await PermissionChecker.IsGrantedAsync(NotificationsPermissions.Email.NotificationsTab))
            {    
            <button class="nav-link" id="nav-notifications-tab" data-bs-toggle="tab" data-bs-target="#nav-notifications" type="button" role="tab">Notifications</button>
            }
            @if (Model?.ShowAITab == true)
            {
                <button class="nav-link" id="nav-ai-configuration-tab" data-bs-toggle="tab"
                    data-bs-target="#nav-ai-configuration" type="button" role="tab">AI</button>
            }
        </div>
    </nav>
    <div class="tab-content unt-tab-content" id="nav-tabContent">
        <!--Tab Content: Mapping-->
        <div id="nav-mapping" class="tab-pane fade show active container-fluid" role="tabpanel" aria-labelledby="nav-mapping-tab">
            <input type="hidden" id="refresh_available_worksheets" value="" />
            <div class="configuration-action-bar row">
                <div class="col-12 col-md-8">
                    <h5>Mapping Configuration</h5>
                </div>
                <div class="col-12 col-md-4 btn-wrapper">
                    <abp-button id="btn-save" text="Save" icon-type="Other" icon="fl fl-save"
                                class="btn unt-btn-primary btn-primary"
                                style="pointer-events: all;"
                                abp-tooltip="Save the Scoresheet and the Mapping of Unity fields to CHEFS Fields"
                                button-type="Primary" />
                    <abp-button id="btn-edit" text="Edit Mapping" icon-type="Other" data-target="#editMappingModal"
                                icon="fl fl-edit" class="btn unt-btn-primary btn-primary" data-toggle="modal"
                                style="pointer-events: all;" abp-tooltip="Edit the Mapping JSON Manually"
                                button-type="Primary" />
                    @if (await PermissionChecker.IsGrantedAsync(AIPermissions.FormMapping.Generate))
                    {
                        <button type="button" id="btn-generate" class="btn ai-generate-btn unt-btn-outline-primary btn-outline-primary"
                                data-ai-cooldown-checking="1" data-ai-rate-limit-disabled="1" disabled
                                title="Generate the mapping for the current form version">
                            <span class="ai-button-content">
                                <i class="unt-icon-sm fa-solid fa-wand-magic-sparkles"></i>
                                <span>Generate Mapping</span>
                            </span>
                        </button>
                    }
                    @if (await PermissionChecker.IsGrantedAsync(AIPermissions.FormWorksheet.Generate))
                    {
                        <button type="button" id="btn-generate-worksheet" class="btn ai-generate-btn unt-btn-outline-primary btn-outline-primary"
                                data-ai-cooldown-checking="1" data-ai-rate-limit-disabled="1" data-ai-pending="false" disabled
                                title="Generate worksheet suggestions for the current form version">
                            <span class="ai-button-content">
                                <i class="unt-icon-sm fa-solid fa-wand-magic-sparkles"></i>
                                <span>Generate Worksheet</span>
                            </span>
                        </button>
                        <button type="button" id="btn-review-worksheet" class="btn unt-btn-outline-primary btn-outline-primary d-none"
                                title="Review pending worksheet suggestions">
                            <span class="ai-button-content">
                                <i class="unt-icon-sm fa-solid fa-wand-magic-sparkles"></i>
                                <span>Review Worksheet</span>
                            </span>
                        </button>
                    }
                    <abp-button id="btn-reset" text="Reset Mapping" icon-type="Other" icon="fl fl-undo"
                                class="btn unt-btn-outline-primary btn-outline-primary"
                                abp-tooltip="This button resets the mapping to the last saved state" />
                    <abp-button id="btn-back" text="Back"
                                class="btn unt-btn-outline-primary btn-outline-primary"
                                abp-tooltip="Navigate back to the Forms" />
                </div>
            </div>
            <div class="row">
                <div class="col-6 p-3">
                    <label for="applicationFormVersion" class="form-label">Version:</label>
                    <div class="select-icon-wrapper">
                        <select class="form-select form-control" id="applicationFormVersion" name="Version">
                            @foreach (var applicationFormVersionDto in Model?.ApplicationFormVersionDtoList ?? new
                                                        List<ApplicationFormVersionDto>
                            { })
                            {
                                @if (@applicationFormVersionDto.ChefsFormVersionGuid + "" != "")
                                {
                                    var selected = false;
                                    @if (Model?.ChefsFormVersionGuid + "" == applicationFormVersionDto.ChefsFormVersionGuid)
                                    {
                                        selected = true;
                                    }

                                    <option value="@applicationFormVersionDto.ChefsFormVersionGuid" selected="@(selected)">
                                        @applicationFormVersionDto.Version - @applicationFormVersionDto.ChefsFormVersionGuid
                                    </option>
                                }
                            }
                        </select>
                        @if (Model?.ApplicationFormVersionDto?.Published == true)
                        {
                            <i class="fl fl-tick published-tick" data-toggle="tooltip" title="This form is published"></i>
                        }
                    </div>
                </div>
                <div class="col-6 p-3">
                    <label for="chefsFormVersionId" class="form-label">Form Version ID:</label>
                    <div class="input-button-wrapper ">
                        <input id="chefsFormVersionId" class="form-control input-width" type="text"
                            value="@Model?.ChefsFormVersionGuid">
                        <abp-button id="btn-sync" text="Sync" disabled="false" icon-type="Other" icon="fl fl-synch"
                            class="btn unt-btn-success btn-success"
                            abp-tooltip="Call out to CHEFS and bring back all the Available CHEFS form Fields. This action requires a Form Version ID to be entered"
                            button-type="Success" />
                    </div>
                </div>
            </div>
            <div class="unt-mapping-container">
                <div class="row">
                    <div class="col-8">
                        <div class="label table-title">Chefs Fields</div>
                    </div>
                    <div class="col-4">
                        <!--Tab list 2-->
                        <nav aria-label="Field mapping tabs">
                            <div class="nav nav-tabs" role="tablist">
                                <button class="nav-link active" id="nav-intake-fields-tab" data-bs-toggle="tab"
                                    data-bs-target="#nav-intake-fields" type="button" role="tab">Core Fields</button>
                                <button class="nav-link" id="nav-worksheet-fields-tab" data-bs-toggle="tab"
                                    data-bs-target="#nav-worksheet-fields" type="button" role="tab">Custom
                                    Fields</button>
                            </div>
                        </nav>
                    </div>
                </div>
                <div class="row">
                    <div class="col-8">
                        <div class="application-forms-table-content">
                            <abp-table id="ApplicationFormsTable" class="chef-field-table table table-striped">
                                <thead>
                                    <tr>
                                        <th scope="Column">CHEFS Label</th>
                                        <th scope="Column">CHEFS Property Name</th>
                                        <th scope="Column">CHEFS Type</th>
                                        <th scope="Column">Map To Unity</th>
                                    </tr>
                                </thead>
                            </abp-table>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="tab-content unt-tab-content" id="nav-tabContent-2">
                            <!--Tab Content: Mapping-->
                            <div class="tab-pane fade show active" id="nav-intake-fields" role="tabpanel"
                                aria-labelledby="nav-intake-fields-tab">

                                <div class="intake-mapping-content">
                                    <div id="intake-map-available-fields-column" class="col" style="overflow-y:scroll">
                                    </div>
                                </div>
                            </div>
                            <!--Tab Content: Worksheet Fields-->
                            <div class="tab-pane fade" id="nav-worksheet-fields" role="tabpanel"
                                aria-labelledby="nav-worksheet-fields-tab">
                                <div class="worksheet-mapping-content">
                                    <div id="worksheet-map-available-fields-column" class="col"
                                        style="overflow-y:scroll">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--Tab Content: Worksheets-->
        @if (Model?.FlexEnabled == true)
        {
            <div id="nav-custom-fields" class="tab-pane fade container-fluid" role="tabpanel" aria-labelledby="nav-custom-fields-tab">
                <div id="customFieldsWidget">
                    @await Component.InvokeAsync("CustomFields", 
                        new {   formVersionId = Model?.ApplicationFormVersionDto?.ChefsFormVersionGuid?.ToString(), 
                                formName = Model?.ApplicationFormDto?.ApplicationFormName 
                            }
                    )
                </div>
            </div>
        }

        <!--Tab Content: UI Configuration loaded by initializeUIConfiguration-->
        <div class="tab-pane fade" id="nav-ui-configuration" role="tabpanel" aria-labelledby="nav-ui-configuration-tab"></div>

        @if (await FeatureChecker.IsEnabledAsync("Unity.Payments"))
        {
        <!--Tab Content: Payment Configuration-->
        <div id="nav-payment-configuration" class="tab-pane fade" role="tabpanel" aria-labelledby="nav-payment-configuration-tab">
            <div id="paymentConfigurationWidget">
                @await Component.InvokeAsync("PaymentConfiguration", new { formid = @Model?.ApplicationFormDto?.Id})
            </div>
        </div>
        }

        @if (await FeatureChecker.IsEnabledAsync("Unity.Reporting")
                && await PermissionChecker.IsGrantedAsync(ReportingPermissions.Configuration.Default))
        {
            <!--Tab Content: Reporting Configuration-->
            <div class="tab-pane fade" 
                 id="nav-reporting-configuration" 
                 role="tabpanel" 
                 aria-labelledby="nav-reporting-configuration-tab">
                @await Component.InvokeAsync("ReportingConfiguration", new { formid = @Model?.ApplicationFormDto?.Id })
            </div>
        }

        <!--Tab Content: Other Configuration-->
        <div class="tab-pane fade" id="nav-other-configuration" role="tabpanel"
            aria-labelledby="nav-other-configuration-tab">
            @await Component.InvokeAsync(typeof(ApplicationFormConfigWidget), new { configType = "Other",
            applicationForm = Model?.ApplicationFormDto })
        </div>


        <!--Tab Content: Notifications -->
         @if (await FeatureChecker.IsEnabledAsync("Unity.Notifications")) {
        <div class="tab-pane fade" id="nav-notifications" role="tabpanel"
            aria-labelledby="nav-notifications-tab">
            @await Component.InvokeAsync(typeof(Notifications), new { formid = Model?.ApplicationFormDto?.Id.ToString() })
        </div>
        }

        @if (Model?.ShowAITab == true)
        {
            <!--Tab Content: AI Configuration-->
            <div id="nav-ai-configuration" class="tab-pane fade container-fluid" role="tabpanel" aria-labelledby="nav-ai-configuration-tab">
                @await Component.InvokeAsync("AIConfiguration", new { formId = Model?.ApplicationFormDto?.Id })
            </div>
        }
    </div>

    <abp-modal centered="true" scrollable="true" size="Large" id="editMappingModal">
            <abp-modal-header title="Edit Mapping JSON"></abp-modal-header>
        <abp-modal-body>
            <textarea id="jsonText" rows="15"
                cols="80" aria-label="Mapping JSON">@Model?.ApplicationFormVersionDto?.SubmissionHeaderMapping</textarea>
        </abp-modal-body>
        <abp-modal-footer>
            <abp-button id="btn-save-mapping" text="Save Mapping JSON" icon-type="Other"
                class="btn unt-btn-primary btn-primary" abp-tooltip="Save the Mapping JSON" button-type="Primary" />
            <abp-button id="btn-cancel-mapping" text="Cancel" icon-type="Other" class="btn unt-btn-link btn-link"
                abp-tooltip="Cancel the Edit" button-type="Secondary" />
        </abp-modal-footer>
    </abp-modal>
    <abp-modal centered="true" scrollable="true" size="Large" id="aiMappingReviewModal">
        <abp-modal-header title="Review AI mapping suggestions"></abp-modal-header>
        <abp-modal-body>
            <div id="aiMappingReviewFields"></div>
            <div id="aiMappingReviewEmpty" class="text-muted d-none">No mapping suggestions remain.</div>
        </abp-modal-body>
        <abp-modal-footer>
            <button type="button" id="btn-add-ai-mapping" class="btn unt-btn-primary btn-primary">Add to map</button>
            <button type="button" id="btn-review-later-ai-mapping" class="btn unt-btn-outline-primary btn-outline-primary">Review later</button>
            <button type="button" id="btn-discard-ai-mapping" class="btn btn-outline-danger">Discard remaining</button>
        </abp-modal-footer>
    </abp-modal>
    <div class="modal fade" id="aiWorksheetReviewModal" tabindex="-1" aria-labelledby="aiWorksheetReviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content ai-worksheet-review">
                <div class="ai-worksheet-review__panel">
                    <div class="modal-header ai-worksheet-review__header">
                        <h5 class="modal-title" id="aiWorksheetReviewModalLabel">Create worksheet draft</h5>
                    </div>
                    <div class="modal-body ai-worksheet-review__body">
                        <div class="ai-worksheet-review__title-group">
                            <label for="aiWorksheetTitle" class="form-label">Worksheet title</label>
                            <input id="aiWorksheetTitle" class="form-control" type="text" required maxlength="256" placeholder="e.g., Project details" autocomplete="off" />
                        </div>
                        <div class="ai-worksheet-review__list">
                            <div class="ai-worksheet-review__table-header">
                                <span>Source field</span><span aria-hidden="true"></span><span>Worksheet field</span>
                                <div class="form-check unt-form-switch form-switch mb-0 ai-worksheet-review__select-all">
                                    <input id="aiWorksheetReviewSelectAll" class="form-check-input" type="checkbox" aria-label="Include all suggested fields" />
                                </div>
                            </div>
                            <div id="aiWorksheetReviewFields"></div>
                            <div id="aiWorksheetReviewEmpty" class="ai-worksheet-review__empty d-none">No custom fields were suggested.</div>
                        </div>
                    </div>
                    <div class="modal-footer ai-worksheet-review__footer">
                        <button type="button" id="btn-create-ai-worksheet-draft" class="btn unt-btn-primary btn-primary" disabled>Create draft</button>
                        <button type="button" class="btn unt-btn-outline-primary btn-outline-primary" data-bs-dismiss="modal">Review later</button>
                        <button type="button" id="btn-discard-ai-worksheet" class="btn btn-outline-danger ai-worksheet-review__discard">Discard remaining</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
