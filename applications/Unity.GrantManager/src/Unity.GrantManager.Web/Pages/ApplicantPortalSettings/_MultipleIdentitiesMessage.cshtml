@using Microsoft.Extensions.Localization
@using Unity.GrantManager.Localization
@model Unity.GrantManager.ApplicantPortal.MultipleIdentitiesMessageDto
@inject IStringLocalizer<GrantManagerResource> L

<section id="portal-messages-div" class="input-area card mb-3 portal-settings-config d-none" aria-labelledby="multiple-identities-heading">
    <h5 id="multiple-identities-heading" class="portal-message-heading">@L["ApplicantPortalSettings:MultipleIdentitiesMessage"]</h5>
    <p class="mb-1">@L["ApplicantPortalSettings:MessageDescription"]</p>
    <p class="pb-3 border-bottom">@L["ApplicantPortalSettings:MessageInstructions"]</p>
    <form id="PortalMessageForm" novalidate
          data-use-default="@Model.UseDefaultMessage.ToString().ToLowerInvariant()"
          data-max-html-length="@Model.MaxHtmlLength">
        <div class="row g-3 align-items-start my-2">
            <div class="col-12 col-lg-6">
                <div class="form-check form-switch portal-message-toggle">
                    <input id="UseDefaultMultipleIdentitiesMessage" class="form-check-input" type="checkbox" role="switch"
                           checked="@Model.UseDefaultMessage" aria-describedby="portal-message-default-help" />
                    <label class="form-check-label fw-bold" for="UseDefaultMultipleIdentitiesMessage">@L["ApplicantPortalSettings:UseDefaultMessage"]</label>
                </div>
                <p id="portal-message-default-help" class="text-muted mt-2">@L["ApplicantPortalSettings:DefaultMessageHelp"]</p>
            </div>
            <div class="col-12 col-lg-6 d-flex justify-content-start gap-3">
                <div>
                    <div class="fw-bold">@L["ApplicantPortalSettings:ResetToDefault"]</div>
                    <p class="text-muted mt-2">@L["ApplicantPortalSettings:ResetMessageHelp"]</p>
                </div>
                <button id="ResetPortalMessageButton" class="btn btn-outline-primary align-self-start" type="button" disabled>@L["ApplicantPortalSettings:ResetChanges"]</button>
            </div>
        </div>
        <label class="form-label fw-bold" for="MultipleIdentitiesMessage">@L["ApplicantPortalSettings:Message"] <span class="text-danger" aria-hidden="true">*</span></label>
        <textarea id="MultipleIdentitiesMessage" class="form-control" rows="9" required
                  aria-describedby="portal-message-length portal-message-error">@Model.MessageHtml</textarea>
        <textarea id="DefaultMultipleIdentitiesMessage" hidden aria-hidden="true">@Model.DefaultMessageHtml</textarea>
        <textarea id="CustomMultipleIdentitiesMessage" hidden aria-hidden="true">@Model.CustomMessageHtml</textarea>
        <div id="portal-message-length" class="form-text text-end"></div>
        <div id="portal-message-error" class="text-danger mt-2" role="alert" hidden></div>
        <aside class="portal-message-parameters mt-4" aria-labelledby="portal-message-parameters-heading">
            <i class="fa-solid fa-circle-info text-primary" aria-hidden="true"></i>
            <div>
                <h6 id="portal-message-parameters-heading" class="fw-bold">@L["ApplicantPortalSettings:AvailableEmailParameter"]</h6>
                <p>@L["ApplicantPortalSettings:EmailParameterHelp"]</p>
                <span class="portal-message-token">{inboxEmail}</span> — @L["ApplicantPortalSettings:InboxEmailDescription"]
            </div>
        </aside>
        <div class="d-flex justify-content-end gap-3 mt-4 portal-settings-actions">
            <button id="CancelPortalMessageButton" class="btn btn-outline-primary" type="button" disabled>@L["ApplicantPortalSettings:CancelMessage"]</button>
            <button id="SavePortalMessageButton" class="btn btn-primary" type="submit" disabled>@L["ApplicantPortalSettings:SaveMessage"]</button>
        </div>
    </form>
</section>
