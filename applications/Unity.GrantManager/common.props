<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
	<AbpProjectType>app</AbpProjectType>
  </PropertyGroup>

  <Target Name="NoWarnOnRazorViewImportedTypeConflicts" BeforeTargets="RazorCoreCompile">
    <PropertyGroup>
      <NoWarn>$(NoWarn);0436</NoWarn>
      <NoWarn>$(NoWarn);NU1510</NoWarn>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Content Remove="$(UserProfile)\.nuget\packages\*\*\contentFiles\any\*\*.abppkg*.json" />
  </ItemGroup>

  <!-- System.Security.Cryptography.Xml comes in transitively through NPOI 2.8.1 (10.0.10) and through
       ABP Identity's Microsoft.AspNetCore.DataProtection (10.0.11). Both are vulnerable (fixed in 10.0.13).
       Pinning it also lifts its dependency System.Security.Cryptography.Pkcs to the patched version.
       Pinned at 10.0.15 to match Microsoft.AspNetCore.DataProtection(.StackExchangeRedis) 10.0.15 (NU1605 otherwise).
       Unity.GrantManager.Web sets ExcludeExplicitCryptographyXml to true, because the ASP.NET Core
       shared framework already ships this assembly and the pin there raises NU1510.
       Projects under modules/Unity.AI, Flex, Notifications, Payments and Reporting import their own
       module common.props instead of this file. They get the pinned version through their project references,
       except Unity.AI.Application, which references NPOI directly and carries its own pin.
       Remove once both parents depend on 10.0.15 or newer. To check, run
       dotnet restore force with -p:ExcludeExplicitCryptographyXml=true and read the NU190x warnings.
       Don't use dotnet list package vulnerable for this, since it re-restores with the pin back on. -->
  <ItemGroup Condition="'$(ExcludeExplicitCryptographyXml)' != 'true'">
    <PackageReference Include="System.Security.Cryptography.Xml"
                      Version="10.0.15" />
  </ItemGroup>

</Project>