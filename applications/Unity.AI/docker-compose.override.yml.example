# Local development overrides for docker-compose.yml.
# Copy this file to docker-compose.override.yml (gitignored) to activate.
# Docker Compose merges it automatically — no flags needed.
#
# 1. Mount tenant_config.local.json so local secrets (e.g. api_key) are available
#    inside the container without being committed to the repo.
# 2. Share GrantManager's Postgres container "unitydb" (pgvector/pgvector:pg17-trixie)
#    instead of the standalone postgres service - like ce395f-dev, where dev and dev2
#    each run every Unity database on one Postgres cluster. Start Unity.GrantManager's
#    stack first (docker compose up -d). The database name in .env (DB_NAME) should
#    match the running OpenShift environments: UnityAI.
#    To use the standalone postgres instead: docker compose --profile standalone-db up -d
#    (it publishes 5432, so stop unitydb first).

services:
  postgres:
    profiles: ["standalone-db"]
  reporting:
    depends_on: !reset {}
    environment:
      # Network alias of unitydb on unity_local_common-network (same host name Grants uses)
      - DB_HOST=unity-data-postgres
    networks: !override
      - unity-local
    volumes:
      - ./Unity.AI.Reporting.Backend/src/tenant_config.local.json:/app/backend/src/tenant_config.local.json

networks:
  unity-local:
    external: true
    name: unity_local_common-network
